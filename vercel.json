{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "env": {
    "VITE_AUTH_ENABLED": "true"
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        { "key": "Clear-Site-Data", "value": "\"cache\"" }
      ]
    },
    {
      "source": "/test",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        { "key": "Clear-Site-Data", "value": "\"cache\"" }
      ]
    },
    {
      "source": "/assets/scoring-CbYZLW6Q.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/assets/scoring-CbYZLW6Q.js",
      "destination": "/retired-bank.js"
    },
    {
      "source": "/assets/scoring-Ch4Gr0ac.js",
      "destination": "/retired-bank.js"
    },
    {
      "source": "/assets/scoring-YZ_nzKzm.js",
      "destination": "/retired-bank.js"
    },
    {
      "source": "/assets/scoring-BGGHnEI9.js",
      "destination": "/retired-bank.js"
    },
    {
      "source": "/assets/scoring-sqrX3b8z.js",
      "destination": "/retired-bank.js"
    },
    {
      "source": "/assets/scoring-CYwmJBPs.js",
      "destination": "/retired-bank.js"
    }
  ]
}
